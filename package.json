{
  "name": "tiny-store",
  "version": "0.1.0",
  "description": "A tiny, framework-agnostic reactive state container.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./middleware": "./src/middleware/index.js",
    "./react": "./src/react.js"
  },
  "files": [
    "src"
  ],
